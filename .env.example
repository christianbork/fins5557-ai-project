# Copy this file to .env and fill in your own key. Never commit .env.
GOOGLE_API_KEY=

# Which LLM writes the decline letter: template (no AI), ollama (local, closed) or gemini
LLM_BACKEND=template

# Optional: Kaggle API credentials for `python -m src.data` (alternative to kagglehub.login()). Never commit these.
KAGGLE_USERNAME=
KAGGLE_KEY=
