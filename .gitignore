# Secrets - never commit
.env
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Data and models (keep large or private files out of Git)
data/*
!data/.gitkeep
*.pkl
*.joblib
# The deployed app needs the trained model (about 6 MB) and its metadata, so these are committed.
!models/model.joblib
!models/*.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Training outputs that are regenerated by python -m src.train
reports/validation_predictions.csv
